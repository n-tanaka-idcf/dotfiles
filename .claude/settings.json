{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(shellcheck *)",
      "Bash(hadolint *)",
      "Bash(mise exec -- task environment:check)",
      "Bash(chezmoi diff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Read(./.devcontainer/.env)",
      "Read(//misc/claude/.credentials.json)",
      "Read(//misc/gh/hosts.yml)"
    ]
  }
}
